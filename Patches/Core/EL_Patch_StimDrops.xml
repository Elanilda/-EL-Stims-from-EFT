<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- ============================================================ -->
  <!-- 方案A: 针剂非制造获取途径 -->
  <!-- 双通道: 任务奖励池 + 古代综合建筑战利品 -->
  <!-- ============================================================ -->

  <!-- ============================================================ -->
  <!-- 第一部分: 给所有针剂加 thingSetMakerTag -->
  <!-- 加入 RewardStandardLowFreq 标签后, 针剂会自动出现在: -->
  <!--   1. Reward_ItemsStandard (通用任务奖励, weight=1, 稀有) -->
  <!--   2. Reward_ReliquaryPilgrims (Ideology朝圣者遗物) -->
  <!-- 注意: 标签为 LowFreq 是为了保持针剂稀有度, 避免泛滥 -->
  <!-- 注意: MapGen_AncientPodContents(cryptosleep casket)是C#硬编码, -->
  <!--       不读thingSetMakerTags, 针剂无法出现在古代胶囊里 -->
  <!-- ============================================================ -->

  <!-- EL_Stim_2A2_bTG -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName="EL_Stim_2A2_bTG"]</xpath>
    <value>
      <thingSetMakerTags>
        <li>RewardStandardLowFreq</li>
      </thingSetMakerTags>
    </value>
  </Operation>

