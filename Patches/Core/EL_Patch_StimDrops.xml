  <!-- ============================================================ -->
  <!-- 图纸系统已停用: 配方改为通过研究解锁 (DrugProduction/MedicineProduction) -->
  <!-- 原图纸Patch已移除, 蓝图C#组件保留在Elanilda's Toolkit前置库中 -->
  <!-- ============================================================ -->

  <!-- ============================================================ -->
  <!-- 第二部分: 往古代综合建筑战利品池注入针剂option -->
  <!-- MapGen_AncientComplexRoomLoot_Default 用 ThingSetMaker_RandomOption -->
  <!-- 添加一个新的li选项, weight=0.15(低概率, 与高级零部件/超科技药同级) -->
  <!-- countRange 1~5: 单次掉落1~5支随机针剂 -->
  <!-- ============================================================ -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingSetMakerDef[defName="MapGen_AncientComplexRoomLoot_Default"]/root/options</xpath>
    <value>
      <li>
        <weight>0.2</weight>
        <thingSetMaker Class="ThingSetMaker_StackCount">
          <fixedParams>
            <filter>
              <thingDefs>
                <li>EL_Stim_2A2_bTG</li>
                <li>EL_Stim_3_bTG</li>
                <li>EL_Stim_AHF1M</li>
                <li>EL_Stim_L1_Norepinephrine</li>
                <li>EL_Stim_Meldonin</li>
                <li>EL_Stim_Morphine</li>
                <li>EL_Stim_P22_22cpd</li>
                <li>EL_Stim_SJ1_TGLabs</li>
                <li>EL_Stim_SJ12_TGLabs</li>
                <li>EL_Stim_SJ6_TGLabs</li>
                <li>EL_Stim_Trimadol</li>
                <li>EL_Stim_Zagustin</li>
                <li>EL_Stim_Adrenaline</li>
                <li>EL_Stim_PNB</li>
                <li>EL_Stim_Propital</li>
                <li>EL_Stim_MULE</li>
                <li>EL_Stim_SJ9_TGLabs</li>
                <li>EL_Stim_xTG12_Antidote</li>
                <li>EL_Stim_Perfotoran</li>
                <li>EL_Stim_eTGchange</li>
                <li>EL_Stim_Obd2_cocktail</li>
                <li>EL_Stim_Obdolbos</li>
              </thingDefs>
            </filter>
            <countRange>1~5</countRange>
          </fixedParams>
        </thingSetMaker>
      </li>
    </value>
  </Operation>

</Patch>
