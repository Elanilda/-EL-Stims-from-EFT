<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- 2A2-(b-TG) 体能提升效果 -->
  <!-- 900秒: 携带能力+30%, 操作/视觉/听觉+20%, 每秒消耗0.001饮食 -->
  <!-- 总持续900秒, severityPerDay ≈ -1.11 -->
  <!-- severity 1.0→0: 全程效果一致, 无阶段区分 -->
  <!-- ============================================================ -->
  <HediffDef ParentName="AddedBodyPartBase">
    <defName>EL_Hediff_2A2_bTG</defName>
    <label>2A2-(b-TG)体能提升</label>
    <labelNoun>2A2-(b-TG)体能提升</labelNoun>
    <description>2A2-(b-TG)正在发挥药效，中枢神经系统受到维稳，承载能力和感知能力全面提升。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1.0</initialSeverity>
    <defaultLabelColor>(0.60, 0.15, 0.15)</defaultLabelColor>
    <comps>
      <!-- 900秒 = 54000 ticks, severityPerDay = -1.0/(54000/60000) ≈ -1.11 -->
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.11</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>54000</disappearsAfterTicks>
      </li>
      <!-- 分阶段饮食消耗: 全程900秒每秒0.001, 共0.9 -->
      <li Class="EL_HediffCompProperties_StageHungerDrain">
        <stages>
          <li>
            <startSeverity>1.0</startSeverity>
            <endSeverity>0.0</endSeverity>
            <hungerPerSecond>0.001</hungerPerSecond>
            <description>每秒消耗0.001饮食，持续900秒。</description>
          </li>
        </stages>
      </li>
    </comps>
    <stages>
      <!-- 全程效果一致: 携带能力+30%, 操作/视觉/听觉+20% -->
      <li>
        <minSeverity>0.0</minSeverity>
        <label>高效期</label>
        <statFactors>
          <CarryingCapacity>1.3</CarryingCapacity>
        </statFactors>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>0.20</offset>
          </li>
          <li>
            <capacity>Sight</capacity>
            <offset>0.20</offset>
          </li>
          <li>
            <capacity>Hearing</capacity>
            <offset>0.20</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
