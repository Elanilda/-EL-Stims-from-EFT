<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- Obdolbos 鸡尾酒兴奋剂 主Hediff -->
  <!-- 主Hediff仅做600秒计时与效果调度, 自身无任何效果 -->
  <!-- 施加时由EL_HediffComp_ObdolbosEffectPicker对15条子Hediff每条独立25%判定 -->
  <!-- 主Hediff移除时自动清除所有可能残留的子Hediff -->
  <!-- severityPerDay = -1.0/(36000/60000) ≈ -1.667 -->
  <!-- 注: 子Hediff独立计时(同为600秒), 可能在主Hediff移除前自行消失 -->
  <!-- ============================================================ -->
  <HediffDef ParentName="AddedBodyPartBase">
    <defName>EL_Hediff_Obdolbos</defName>
    <label>Obd机能紊乱</label>
    <labelNoun>Obd机能紊乱</labelNoun>
    <description>Obd如同鸡尾酒一样繁多的效果正在发挥药效，具体点的话就是列表里这些。</description>
    <descriptionHyperlinks>
      <HediffDef>EL_Hediff_Obd_Effect01</HediffDef>
      <HediffDef>EL_Hediff_Obd_Effect02</HediffDef>
      <HediffDef>EL_Hediff_Obd_Effect03</HediffDef>
      <HediffDef>EL_Hediff_Obd_Effect04</HediffDef>
      <HediffDef>EL_Hediff_Obd_Effect05</HediffDef>
      <HediffDef>EL_Hediff_Obd_Effect06</HediffDef>
      <HediffDef>EL_Hediff_Obd_Effect07</HediffDef>
      <HediffDef>EL_Hediff_Obd_Effect08</HediffDef>
      <HediffDef>EL_Hediff_Obd_Effect09</HediffDef>
      <HediffDef>EL_Hediff_Obd_Effect10</HediffDef>
      <HediffDef>EL_Hediff_Obd_Effect11</HediffDef>
      <HediffDef>EL_Hediff_Obd_Effect12</HediffDef>
      <HediffDef>EL_Hediff_Obd_Effect13</HediffDef>
      <HediffDef>EL_Hediff_Obd_Effect14</HediffDef>
      <HediffDef>EL_Hediff_Obd_Effect15</HediffDef>
    </descriptionHyperlinks>
    <hediffClass>EL_Hediff_RawLabel</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1.0</initialSeverity>
    <defaultLabelColor>(0.60, 0.85, 0.55)</defaultLabelColor>
    <comps>
      <!-- 600秒 = 36000 ticks, severityPerDay ≈ -1.667 -->
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.667</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>36000</disappearsAfterTicks>
      </li>
      <!-- 随机效果选择器: 对15条子Hediff每条独立25%几率判定 -->
      <li Class="EL_HediffCompProperties_ObdolbosEffectPicker">
        <chance>0.25</chance>
        <effectHediffs>
          <li>EL_Hediff_Obd_Effect01</li>
          <li>EL_Hediff_Obd_Effect02</li>
          <li>EL_Hediff_Obd_Effect03</li>
          <li>EL_Hediff_Obd_Effect04</li>
          <li>EL_Hediff_Obd_Effect05</li>
          <li>EL_Hediff_Obd_Effect06</li>
          <li>EL_Hediff_Obd_Effect07</li>
          <li>EL_Hediff_Obd_Effect08</li>
          <li>EL_Hediff_Obd_Effect09</li>
          <li>EL_Hediff_Obd_Effect10</li>
          <li>EL_Hediff_Obd_Effect11</li>
          <li>EL_Hediff_Obd_Effect12</li>
          <li>EL_Hediff_Obd_Effect13</li>
          <li>EL_Hediff_Obd_Effect14</li>
          <li>EL_Hediff_Obd_Effect15</li>
        </effectHediffs>
      </li>
    </comps>
  </HediffDef>

