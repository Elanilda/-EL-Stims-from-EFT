    <defName>EL_Surgery_InjectMorphine</defName>
    <label>注射吗啡</label>
    <description>注射吗啡以镇痛。</description>
    <jobString>正在为TargetA注射吗啡针剂。</jobString>
    <!-- 手术图标: 使用吗啡注射器贴图(指向具体文件,不含扩展名) -->
    <uiIconPath>Stims/Morphine/EL_Morphine</uiIconPath>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Stim_Morphine</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Stim_Morphine</li>
      </thingDefs>
    </fixedIngredientFilter>
  </RecipeDef>

