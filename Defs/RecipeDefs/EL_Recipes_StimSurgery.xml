<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- Abstract父类: 所有针剂注射手术的通用配置 -->
  <!-- 继承原版SurgeryFlesh以获得手术界面默认属性 -->
  <!-- 参考原版BloodTransfusion: 无身体部位目标、不麻醉、总是成功 -->
  <!-- ============================================================ -->
  <RecipeDef Abstract="True" Name="EL_StimSurgeryBase" ParentName="SurgeryFlesh">
    <!-- 总是成功, 无失败/死亡风险 -->
    <surgeryOutcomeEffect IsNull="True" />
    <!-- 不针对具体身体部位 -->
    <targetsBodyPart>false</targetsBodyPart>
    <!-- 不需麻醉 -->
    <anesthetize>false</anesthetize>
    <!-- 隐藏身体部位名称列表 -->
    <hideBodyPartNames>true</hideBodyPartNames>
    <!-- 自定义Worker: 消耗针剂并对目标pawn施加Hediff+扣饮食 -->
    <workerClass>EL_Recipe_InjectStim</workerClass>
    <!-- 工作速度: 医疗操作速度 -->
    <workSpeedStat>MedicalOperationSpeed</workSpeedStat>
    <!-- 工作技能: 医学(影响learnFactor) -->
    <workSkill>Medicine</workSkill>
    <!-- 手术执行时间(120 = 约2秒, 体现注射动作耗时，与音效时长同步) -->
    <workAmount>120</workAmount>
    <!-- 覆盖父类SurgeryFlesh的effectWorking: 移除血液特效, 针剂注射不需要 -->
    <effectWorking IsNull="True" />
    <!-- 覆盖父类SurgeryFlesh的soundWorking: 使用自定义注射音效替代原版手术音效 -->
    <soundWorking>EL_Stim_Inject</soundWorking>
    <!-- 无技能要求: 任何医生可执行 -->
    <!-- recipeUsers不填: 自动对所有Pawn可用, 同原版BloodTransfusion -->
  </RecipeDef>

