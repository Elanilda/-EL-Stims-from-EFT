<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- 吗啡注射器 -->
  <!-- 痛觉×0.05持续305秒, 使用时立刻扣除15%饮食值 -->
  <!-- ============================================================ -->
  <ThingDef ParentName="ResourceBase">
    <defName>EL_Stim_Morphine</defName>
    <label>吗啡注射器</label>
    <description>装有大剂量吗啡的一次性笔式注射器，使用后将大幅抑制痛觉，但会增加代谢消耗。

【施加效果】
疼痛×5%，延迟0秒/持续305秒；
使用时立即扣除0.15饮食值。</description>
    <descriptionHyperlinks>
      <HediffDef>EL_Hediff_Morphine</HediffDef>
    </descriptionHyperlinks>
    <tickerType>Never</tickerType>
    <orderedTakeGroup>Medicine</orderedTakeGroup>
    <graphicData>
      <texPath>Stims/Morphine</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.7</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>48</MarketValue>
      <SellPriceFactor>0.8</SellPriceFactor>
      <Mass>0.05</Mass>
      <MaxHitPoints>25</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
      <WorkToMake>330</WorkToMake>
    </statBases>
    <stackLimit>16</stackLimit>
    <uiIconForStackCount>1</uiIconForStackCount>
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>EL_Stims</li>
    </thingCategories>
    <costList>
      <Neutroamine>10</Neutroamine>
    </costList>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>注射 {0}</useLabel>
        <useDuration>120</useDuration>
      </li>
      <li Class="EL_CompProperties_UseEffect_ApplyHediff">
        <hediffDef>EL_Hediff_Morphine</hediffDef>
        <foodCostFactor>0.15</foodCostFactor>
      </li>
      <li Class="EL_CompProperties_EFTStims" />
    </comps>
  </ThingDef>

  <!-- ============================================================ -->
  <!-- 吗啡注射器 x1 单支生产配方 -->
  <!-- 放在x4配方之前, 确保物品信息界面FirstOrDefault取到1倍配方显示原料 -->
  <!-- ============================================================ -->
  <RecipeDef>
    <defName>EL_Make_Morphine</defName>
    <label>制作吗啡注射器</label>
    <description>制作1支吗啡注射器。</description>
    <jobString>正在制作吗啡注射器。</jobString>
    <workAmount>330</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <skillRequirements>
      <Medicine>4</Medicine>
      <Crafting>4</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>DrugProduction</researchPrerequisite>
    <researchPrerequisites>
      <li>PsychiteRefining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Cartridge</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_Morphine>1</EL_Stim_Morphine>
    </products>
  </RecipeDef>

  <!-- ============================================================ -->
  <!-- 吗啡注射器 x4 批量生产配方 -->
  <!-- 原材料与产物均为1倍配方的4倍, 工作量为4倍 -->
  <!-- ============================================================ -->
  <RecipeDef>
    <defName>EL_Make_Morphine_Bulk</defName>
    <label>制作4个吗啡注射器</label>
    <description>制作一批4支吗啡注射器。</description>
    <jobString>正在制作吗啡注射器。</jobString>
    <workAmount>1320</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <skillRequirements>
      <Medicine>4</Medicine>
      <Crafting>4</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>DrugProduction</researchPrerequisite>
    <researchPrerequisites>
      <li>PsychiteRefining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Cartridge</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>40</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_Morphine>4</EL_Stim_Morphine>
    </products>
  </RecipeDef>

</Defs>
