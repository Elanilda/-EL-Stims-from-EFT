<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- Propital 再生兴奋剂注射器 -->
  <!-- 300秒: 痛觉*0.10(245秒), 消化+20%/愈合+20%/血液过滤+20% -->
  <!-- 全程回复器官损伤(第二档), 270秒后视觉-15%/意识-15% -->
  <!-- ============================================================ -->
  <ThingDef ParentName="ResourceBase">
    <defName>EL_Stim_Propital</defName>
    <label>Propital注射器</label>
    <description>军用体能增强药物，通过增加嘌呤和嘧啶碱基、RNA以及功能性酶的生物合成来刺激机体再生过程，能够增加新陈代谢并抑制痛感，但有较严重的末端副作用，因此往往仅限专业医师施用。

【施加效果】
疼痛×10%，延迟0秒/持续245秒；
消化能力+20%，延迟0秒/持续300秒；
血液过滤+20%，延迟0秒/持续300秒；
愈合系数×120%，延迟0秒/持续300秒；
随机修复任意身体部位1点/秒，延迟0秒/持续300秒；
视觉能力-15%，延迟270秒/持续30秒；
意识-15%，延迟270秒/持续30秒。</description>
    <descriptionHyperlinks>
      <HediffDef>EL_Hediff_Propital</HediffDef>
    </descriptionHyperlinks>
    <tickerType>Never</tickerType>
    <orderedTakeGroup>Medicine</orderedTakeGroup>
    <graphicData>
      <texPath>Stims/Propital</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.7</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>196</MarketValue>
      <SellPriceFactor>0.8</SellPriceFactor>
      <Mass>0.05</Mass>
      <MaxHitPoints>25</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
      <WorkToMake>400</WorkToMake>
    </statBases>
    <stackLimit>16</stackLimit>
    <uiIconForStackCount>1</uiIconForStackCount>
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>EL_Stims</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>注射 {0}</useLabel>
        <useDuration>120</useDuration>
      </li>
      <li Class="EL_CompProperties_UseEffect_ApplyHediff">
        <hediffDef>EL_Hediff_Propital</hediffDef>
      </li>
      <li Class="EL_CompProperties_EFTStims" />
    </comps>
  </ThingDef>

  <!-- ============================================================ -->
  <!-- Propital x1 单支生产配方 -->
  <!-- ============================================================ -->
  <RecipeDef>
    <defName>EL_Make_Propital</defName>
    <label>制作Propital注射器</label>
    <description>制作1支Propital注射器。</description>
    <jobString>正在制作Propital注射器。</jobString>
    <workAmount>400</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <skillRequirements>
      <Medicine>8</Medicine>
      <Intellectual>6</Intellectual>
      <Crafting>4</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>MedicineProduction</researchPrerequisite>
    <researchPrerequisites>
      <li>PsychiteRefining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Cartridge</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_Propital>1</EL_Stim_Propital>
    </products>
  </RecipeDef>

  <!-- ============================================================ -->
  <!-- Propital x4 批量生产配方 -->
  <!-- ============================================================ -->
  <RecipeDef>
    <defName>EL_Make_Propital_Bulk</defName>
    <label>制作4个Propital注射器</label>
    <description>制作一批4支Propital注射器。</description>
    <jobString>正在制作Propital注射器。</jobString>
    <workAmount>1600</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <skillRequirements>
      <Medicine>8</Medicine>
      <Intellectual>6</Intellectual>
      <Crafting>4</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>MedicineProduction</researchPrerequisite>
    <researchPrerequisites>
      <li>PsychiteRefining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Cartridge</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>80</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_Propital>4</EL_Stim_Propital>
    </products>
  </RecipeDef>

</Defs>
