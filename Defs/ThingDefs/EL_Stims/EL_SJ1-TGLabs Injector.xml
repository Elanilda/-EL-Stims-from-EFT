    <defName>EL_Make_SJ1_TGLabs_Bulk</defName>
    <label>制作4个SJ1-TGLabs战斗兴奋剂注射器</label>
    <description>制作一批4支SJ1-TGLabs战斗兴奋剂注射器。</description>
    <jobString>正在制作SJ1-TGLabs战斗兴奋剂注射器。</jobString>
    <workAmount>1120</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <skillRequirements>
      <Medicine>4</Medicine>
      <Intellectual>4</Intellectual>
      <Crafting>4</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>DrugProduction</researchPrerequisite>
    <researchPrerequisites>
      <li>PsychiteRefining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Cartridge</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>40</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_SJ1_TGLabs>4</EL_Stim_SJ1_TGLabs>
    </products>
  </RecipeDef>

</Defs>
