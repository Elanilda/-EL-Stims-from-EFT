      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_SJ9_TGLabs>1</EL_Stim_SJ9_TGLabs>
    </products>
  </RecipeDef>

