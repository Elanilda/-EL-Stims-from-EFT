    <description>制作一批4支曲马多注射器。</description>
    <jobString>正在制作曲马多注射器。</jobString>
    <workAmount>2800</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <skillRequirements>
      <Medicine>10</Medicine>
      <Intellectual>10</Intellectual>
      <Crafting>6</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>MedicineProduction</researchPrerequisite>
    <researchPrerequisites>
      <li>PsychiteRefining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Cartridge</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>88</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_Trimadol>4</EL_Stim_Trimadol>
    </products>
  </RecipeDef>

</Defs>
