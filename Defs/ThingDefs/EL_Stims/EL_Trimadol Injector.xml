<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- Trimadol (曲马多) 兴奋剂注射器 -->
  <!-- 180秒: 痛觉*0.05, 工作+10%/移动+10%/操作+10%, 崩溃×0.9/休克×1.1 -->
  <!-- 休息下降-10%, 每秒恢复0.03休息值, 每秒消耗0.01饮食 -->
  <!-- ============================================================ -->
  <ThingDef ParentName="ResourceBase">
    <defName>EL_Stim_Trimadol</defName>
    <label>曲马多注射器</label>
    <description>服务特战人员的阿片类综合强化剂，能够促进中枢和脊髓神经细胞钾钙离子通道的开放，引起细胞膜超极化并抑制痛感，但会给身体带来巨大的代谢压力。

【施加效果】
疼痛×5%，延迟0秒/持续180秒；
操作能力+10%，延迟0秒/持续180秒；
全局工作速度×110%，延迟0秒/持续180秒；
移动速度×110%，延迟0秒/持续180秒；
崩溃临界值×90%，延迟0秒/持续180秒；
疼痛休克阈值×110%，延迟0秒/持续180秒；
休息值下降速率×90%，延迟0秒/持续180秒；
每秒恢复0.03休息值，延迟0秒/持续180秒；
每秒消耗0.01饮食值，延迟0秒/持续180秒。</description>
    <descriptionHyperlinks>
      <HediffDef>EL_Hediff_Trimadol</HediffDef>
    </descriptionHyperlinks>
    <tickerType>Never</tickerType>
    <orderedTakeGroup>Medicine</orderedTakeGroup>
    <graphicData>
      <texPath>Stims/Trimadol</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.7</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>392</MarketValue>
      <SellPriceFactor>0.8</SellPriceFactor>
      <Mass>0.05</Mass>
      <MaxHitPoints>25</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
      <WorkToMake>700</WorkToMake>
    </statBases>
    <stackLimit>16</stackLimit>
    <uiIconForStackCount>1</uiIconForStackCount>
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>EL_Stims</li>
    </thingCategories>
    <costList>
      <Neutroamine>22</Neutroamine>
    </costList>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>注射 {0}</useLabel>
        <useDuration>120</useDuration>
      </li>
      <li Class="EL_CompProperties_UseEffect_ApplyHediff">
        <hediffDef>EL_Hediff_Trimadol</hediffDef>
      </li>
      <li Class="EL_CompProperties_EFTStims" />
    </comps>
  </ThingDef>

  <!-- ============================================================ -->
  <!-- Trimadol x1 单支生产配方 -->
  <!-- ============================================================ -->
  <RecipeDef>
    <defName>EL_Make_Trimadol</defName>
    <label>制作曲马多注射器</label>
    <description>制作1支曲马多注射器。</description>
    <jobString>正在制作曲马多注射器。</jobString>
    <workAmount>700</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <skillRequirements>
      <Medicine>10</Medicine>
      <Intellectual>10</Intellectual>
      <Crafting>6</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>MedicineProduction</researchPrerequisite>
    <researchPrerequisites>
      <li>PsychiteRefining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Cartridge</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>22</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_Trimadol>1</EL_Stim_Trimadol>
    </products>
  </RecipeDef>

  <!-- ============================================================ -->
  <!-- Trimadol x4 批量生产配方 -->
  <!-- ============================================================ -->
  <RecipeDef>
    <defName>EL_Make_Trimadol_Bulk</defName>
