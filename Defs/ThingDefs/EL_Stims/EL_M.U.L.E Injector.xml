<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- M.U.L.E 兴奋剂注射器 -->
  <!-- 900秒: 携带能力+100%, 每10秒随机损伤非solid部位1点 -->
  <!-- ============================================================ -->
  <ThingDef ParentName="ResourceBase">
    <defName>EL_Stim_MULE</defName>
    <label>M.U.L.E兴奋剂注射器</label>
    <description>极效肌肉激励兴奋剂，被用于在长途行军之前提升身体载荷能力，它在交通不便的作战地区显示了其有效性，能够让士兵如同这款针剂的名字一般长时间承载更多的重量。

【施加效果】
携带能力×200%，延迟0秒/持续900秒；
每10秒对随机非骨骼身体部位造成1点代谢损伤，延迟0秒/持续900秒。</description>
    <descriptionHyperlinks>
      <HediffDef>EL_Hediff_MULE</HediffDef>
    </descriptionHyperlinks>
    <tickerType>Never</tickerType>
    <orderedTakeGroup>Medicine</orderedTakeGroup>
    <graphicData>
      <texPath>Stims/M.U.L.E</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.7</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>968</MarketValue>
      <SellPriceFactor>0.8</SellPriceFactor>
      <Mass>0.05</Mass>
      <MaxHitPoints>25</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
      <WorkToMake>960</WorkToMake>
    </statBases>
    <stackLimit>16</stackLimit>
    <uiIconForStackCount>1</uiIconForStackCount>
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>EL_Stims</li>
    </thingCategories>
    <costList>
      <Neutroamine>32</Neutroamine>
    </costList>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>注射 {0}</useLabel>
        <useDuration>120</useDuration>
      </li>
      <li Class="EL_CompProperties_UseEffect_ApplyHediff">
        <hediffDef>EL_Hediff_MULE</hediffDef>
      </li>
      <li Class="EL_CompProperties_EFTStims" />
    </comps>
  </ThingDef>

  <!-- ============================================================ -->
  <!-- M.U.L.E x1 单支生产配方 -->
  <!-- ============================================================ -->
  <RecipeDef>
    <defName>EL_Make_MULE</defName>
    <label>制作M.U.L.E兴奋剂注射器</label>
    <description>制作1支M.U.L.E兴奋剂注射器。</description>
    <jobString>正在制作M.U.L.E兴奋剂注射器。</jobString>
    <workAmount>960</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <skillRequirements>
      <Medicine>12</Medicine>
      <Intellectual>10</Intellectual>
      <Crafting>6</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>MedicineProduction</researchPrerequisite>
    <researchPrerequisites>
      <li>PsychiteRefining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Cartridge</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>32</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_MULE>1</EL_Stim_MULE>
    </products>
  </RecipeDef>

