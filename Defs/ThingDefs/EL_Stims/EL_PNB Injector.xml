<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- PNB (16号化合物) 兴奋剂注射器 -->
  <!-- 221秒: 意识+20%/工作+40%, 前40秒回复器官损伤(第一档) -->
  <!-- 41秒后意识-15%, 愈合-20%/血液过滤-20%持续180秒 -->
  <!-- ============================================================ -->
  <ThingDef ParentName="ResourceBase">
    <defName>EL_Stim_PNB</defName>
    <label>PNB注射器</label>
    <description>能够短期激活内部肌肉的军用兴奋剂，让这些肌肉组织变为高渗透状态，以降低人体所受伤害；PNB还能提高蛋白合成转运速度，加速组织恢复；有影响免疫代偿的副作用。

【施加效果】
意识+20%，延迟0秒/持续40秒；
全局工作速度×140%，延迟0秒/持续40秒；
随机修复非骨骼身体部位3点/秒，延迟0秒/持续40秒；
意识-15%，延迟40秒/持续20秒；
愈合系数×80%，延迟40秒/持续181秒；
血液过滤-20%，延迟40秒/持续181秒。</description>
    <descriptionHyperlinks>
      <HediffDef>EL_Hediff_PNB</HediffDef>
    </descriptionHyperlinks>
    <tickerType>Never</tickerType>
    <orderedTakeGroup>Medicine</orderedTakeGroup>
    <graphicData>
      <texPath>Stims/PNB</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.7</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>136</MarketValue>
      <SellPriceFactor>0.8</SellPriceFactor>
      <Mass>0.05</Mass>
      <MaxHitPoints>25</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
      <WorkToMake>300</WorkToMake>
    </statBases>
    <stackLimit>16</stackLimit>
    <uiIconForStackCount>1</uiIconForStackCount>
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>EL_Stims</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>注射 {0}</useLabel>
        <useDuration>120</useDuration>
      </li>
      <li Class="EL_CompProperties_UseEffect_ApplyHediff">
        <hediffDef>EL_Hediff_PNB</hediffDef>
      </li>
      <li Class="EL_CompProperties_EFTStims" />
    </comps>
  </ThingDef>

  <!-- ============================================================ -->
  <!-- PNB x1 单支生产配方 -->
  <!-- ============================================================ -->
  <RecipeDef>
    <defName>EL_Make_PNB</defName>
    <label>制作PNB注射器</label>
    <description>制作1支PNB注射器。</description>
    <jobString>正在制作PNB注射器。</jobString>
    <workAmount>300</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <skillRequirements>
      <Medicine>6</Medicine>
      <Intellectual>6</Intellectual>
      <Crafting>4</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>MedicineProduction</researchPrerequisite>
    <researchPrerequisites>
      <li>PsychiteRefining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Cartridge</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>14</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_PNB>1</EL_Stim_PNB>
    </products>
  </RecipeDef>

  <!-- ============================================================ -->
  <!-- PNB x4 批量生产配方 -->
  <!-- ============================================================ -->
  <RecipeDef>
    <defName>EL_Make_PNB_Bulk</defName>
    <label>制作4个PNB注射器</label>
    <description>制作一批4支PNB注射器。</description>
    <jobString>正在制作PNB注射器。</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <skillRequirements>
      <Medicine>6</Medicine>
      <Intellectual>6</Intellectual>
      <Crafting>4</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>MedicineProduction</researchPrerequisite>
    <researchPrerequisites>
      <li>PsychiteRefining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Cartridge</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>56</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_PNB>4</EL_Stim_PNB>
    </products>
  </RecipeDef>

</Defs>
