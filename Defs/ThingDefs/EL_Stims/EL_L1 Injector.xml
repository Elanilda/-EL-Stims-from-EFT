<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- L1（去甲肾上腺素）注射器 -->
  <!-- 120秒: 痛觉×0.10, 全局工作速度+40%, 移动+20%, 休息下降-30% -->
  <!-- 前60秒每秒消耗0.009饮食 -->
  <!-- ============================================================ -->
  <ThingDef ParentName="ResourceBase">
    <defName>EL_Stim_L1_Norepinephrine</defName>
    <label>L1（去甲肾上腺素）</label>
    <description>内部装有去甲肾上腺素的一次性笔式注射器，用来短期增强体能并减少疼痛的影响，并且能够增强生理反应的执行力比如"该打还是该跑"，当然，也会增加代谢消耗。

【施加效果】
疼痛×10%，延迟0秒/持续120秒；
全局工作速度×140%，延迟0秒/持续120秒；
移动速度×120%，延迟0秒/持续120秒；
休息值下降速率×70%，延迟0秒/持续120秒；
每秒消耗0.009饮食值，延迟0秒/持续60秒。</description>
    <descriptionHyperlinks>
      <HediffDef>EL_Hediff_L1</HediffDef>
    </descriptionHyperlinks>
    <tickerType>Never</tickerType>
    <orderedTakeGroup>Medicine</orderedTakeGroup>
    <graphicData>
      <texPath>Stims/L1</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.7</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>95</MarketValue>
      <SellPriceFactor>0.8</SellPriceFactor>
      <Mass>0.05</Mass>
      <MaxHitPoints>25</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
      <WorkToMake>350</WorkToMake>
    </statBases>
    <stackLimit>16</stackLimit>
    <uiIconForStackCount>1</uiIconForStackCount>
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>EL_Stims</li>
    </thingCategories>
    <costList>
      <Neutroamine>12</Neutroamine>
    </costList>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>注射 {0}</useLabel>
        <useDuration>120</useDuration>
      </li>
      <li Class="EL_CompProperties_UseEffect_ApplyHediff">
        <hediffDef>EL_Hediff_L1</hediffDef>
      </li>
      <li Class="EL_CompProperties_EFTStims" />
    </comps>
  </ThingDef>

  <!-- ============================================================ -->
  <!-- L1 x1 单支生产配方 -->
  <!-- ============================================================ -->
  <RecipeDef>
    <defName>EL_Make_L1</defName>
    <label>制作L1（去甲肾上腺素）</label>
    <description>制作1支L1去甲肾上腺素注射器。</description>
    <jobString>正在制作L1去甲肾上腺素注射器。</jobString>
    <workAmount>350</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <skillRequirements>
      <Medicine>4</Medicine>
      <Intellectual>4</Intellectual>
      <Crafting>4</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>DrugProduction</researchPrerequisite>
    <researchPrerequisites>
      <li>PsychiteRefining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Cartridge</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>12</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_L1_Norepinephrine>1</EL_Stim_L1_Norepinephrine>
    </products>
  </RecipeDef>

  <!-- ============================================================ -->
  <!-- L1 x4 批量生产配方 -->
  <!-- ============================================================ -->
  <RecipeDef>
    <defName>EL_Make_L1_Bulk</defName>
    <label>制作4个L1（去甲肾上腺素）</label>
    <description>制作一批4支L1去甲肾上腺素注射器。</description>
    <jobString>正在制作L1去甲肾上腺素注射器。</jobString>
    <workAmount>1400</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <skillRequirements>
      <Medicine>4</Medicine>
      <Intellectual>4</Intellectual>
      <Crafting>4</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>DrugProduction</researchPrerequisite>
    <researchPrerequisites>
      <li>PsychiteRefining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Cartridge</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>48</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_L1_Norepinephrine>4</EL_Stim_L1_Norepinephrine>
    </products>
  </RecipeDef>

</Defs>
