<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- P22 (22号化合物) 兴奋剂注射器 -->
  <!-- 125秒: 前60秒愈合+30%/血液过滤+30%/崩溃×0.7/休克×1.3 -->
  <!-- 后65秒移动-20%+每秒扣0.008休息值 -->
  <!-- ============================================================ -->
  <ThingDef ParentName="ResourceBase">
    <defName>EL_Stim_P22_22cpd</defName>
    <label>P22（22号化合物）兴奋剂注射器</label>
    <description>军用的肌肉促进剂，被用来在投入战斗前扩展身体能力，减少身体受到的损伤并加快身体修复，但药效过后有疲劳的副作用。

【施加效果】
愈合系数+30%，延迟0秒/持续60秒；
血液过滤+30%，延迟0秒/持续60秒；
崩溃临界值×70%，延迟0秒/持续60秒；
疼痛休克阈值×130%，延迟0秒/持续60秒；
移动速度×80%，延迟60秒/持续65秒；
每秒消耗0.008休息值，延迟60秒/持续65秒。</description>
    <descriptionHyperlinks>
      <HediffDef>EL_Hediff_P22_22cpd</HediffDef>
    </descriptionHyperlinks>
    <tickerType>Never</tickerType>
    <orderedTakeGroup>Medicine</orderedTakeGroup>
    <graphicData>
      <texPath>Stims/P22</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.7</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>90</MarketValue>
      <SellPriceFactor>0.8</SellPriceFactor>
      <Mass>0.05</Mass>
      <MaxHitPoints>25</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
      <WorkToMake>400</WorkToMake>
    </statBases>
    <stackLimit>16</stackLimit>
    <uiIconForStackCount>1</uiIconForStackCount>
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>EL_Stims</li>
    </thingCategories>
    <costList>
      <Neutroamine>16</Neutroamine>
    </costList>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>注射 {0}</useLabel>
        <useDuration>120</useDuration>
      </li>
      <li Class="EL_CompProperties_UseEffect_ApplyHediff">
        <hediffDef>EL_Hediff_P22_22cpd</hediffDef>
      </li>
      <li Class="EL_CompProperties_EFTStims" />
    </comps>
  </ThingDef>

  <!-- ============================================================ -->
  <!-- P22 x1 单支生产配方 -->
  <!-- ============================================================ -->
  <RecipeDef>
    <defName>EL_Make_P22_22cpd</defName>
    <label>制作P22（22号化合物）兴奋剂注射器</label>
    <description>制作1支P22兴奋剂注射器。</description>
    <jobString>正在制作P22兴奋剂注射器。</jobString>
    <workAmount>400</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <skillRequirements>
      <Medicine>6</Medicine>
      <Intellectual>6</Intellectual>
      <Crafting>4</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>MedicineProduction</researchPrerequisite>
    <researchPrerequisites>
      <li>PsychiteRefining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Cartridge</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>16</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_P22_22cpd>1</EL_Stim_P22_22cpd>
    </products>
  </RecipeDef>

