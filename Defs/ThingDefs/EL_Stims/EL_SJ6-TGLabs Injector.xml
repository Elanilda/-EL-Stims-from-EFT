<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- SJ6-TGLabs 战斗兴奋剂注射器 -->
  <!-- 240秒: 休息下降-30%, 每秒恢复0.02休息值(前200秒) -->
  <!-- 200秒延迟后持续40秒: 意识-15%, 视觉-15% -->
  <!-- 总持续240秒, severityPerDay ≈ -4.17 -->
  <!-- severity 1.0→0.167: 前200秒(高效期: RestFallRate-30%+恢复休息值) -->
  <!-- severity 0.167→0: 后40秒(消退期: 意识-15%, 视觉-15%) -->
  <!-- ============================================================ -->
  <ThingDef ParentName="ResourceBase">
    <defName>EL_Stim_SJ6_TGLabs</defName>
    <label>SJ6-TGLabs战斗兴奋剂注射器</label>
    <description>高效军用运动型针剂，在战斗前进行注射，能有效提升身体综合机能并消除疲倦感，但在药效末端有明显的中枢抑制副作用。

【施加效果】
休息值下降速率×70%，延迟0秒/持续200秒；
每秒恢复0.02休息值，延迟0秒/持续200秒；
意识-15%，延迟200秒/持续40秒；
视觉能力-15%，延迟200秒/持续40秒。</description>
    <descriptionHyperlinks>
      <HediffDef>EL_Hediff_SJ6_TGLabs</HediffDef>
    </descriptionHyperlinks>
    <tickerType>Never</tickerType>
    <orderedTakeGroup>Medicine</orderedTakeGroup>
    <graphicData>
      <texPath>Stims/SJ6-TGLabs</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.7</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>517</MarketValue>
      <SellPriceFactor>0.8</SellPriceFactor>
      <Mass>0.05</Mass>
      <MaxHitPoints>25</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
      <WorkToMake>560</WorkToMake>
    </statBases>
    <stackLimit>16</stackLimit>
    <uiIconForStackCount>1</uiIconForStackCount>
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>EL_Stims</li>
    </thingCategories>
    <costList>
      <Neutroamine>14</Neutroamine>
    </costList>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>注射 {0}</useLabel>
        <useDuration>120</useDuration>
      </li>
      <li Class="EL_CompProperties_UseEffect_ApplyHediff">
        <hediffDef>EL_Hediff_SJ6_TGLabs</hediffDef>
      </li>
      <li Class="EL_CompProperties_EFTStims" />
    </comps>
  </ThingDef>

  <!-- ============================================================ -->
