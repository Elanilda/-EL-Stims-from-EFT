<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- Adrenaline (肾上腺素) 兴奋剂注射器 -->
  <!-- 65秒: 痛觉*0.10, 工作+20%/移动+20%/射击+20% -->
  <!-- 前15秒回复器官损伤(第一档), 30秒后消耗饮食 -->
  <!-- ============================================================ -->
  <ThingDef ParentName="ResourceBase">
    <defName>EL_Stim_Adrenaline</defName>
    <label>肾上腺素注射器</label>
    <description>装有一剂肾上腺素的笔式注射器，用于增强生理反应的同时促进肌肉为强烈运动做准备，可以短暂提升体能并抑制疼痛。

【施加效果】
疼痛×10%，延迟0秒/持续65秒；
操作能力+20%，延迟0秒/持续65秒；
全局工作速度×120%，延迟0秒/持续65秒；
移动速度×120%，延迟0秒/持续65秒；
射击精度×120%，延迟0秒/持续65秒；
随机修复非骨骼身体部位4点/秒，延迟0秒/持续15秒；
每秒消耗0.018饮食值，延迟30秒/持续30秒。</description>
    <descriptionHyperlinks>
      <HediffDef>EL_Hediff_Adrenaline</HediffDef>
    </descriptionHyperlinks>
    <tickerType>Never</tickerType>
    <orderedTakeGroup>Medicine</orderedTakeGroup>
    <graphicData>
      <texPath>Stims/Adrenaline</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.7</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>81</MarketValue>
      <SellPriceFactor>0.8</SellPriceFactor>
      <Mass>0.05</Mass>
      <MaxHitPoints>25</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
      <WorkToMake>200</WorkToMake>
    </statBases>
    <stackLimit>16</stackLimit>
    <uiIconForStackCount>1</uiIconForStackCount>
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>EL_Stims</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>注射 {0}</useLabel>
        <useDuration>120</useDuration>
      </li>
      <li Class="EL_CompProperties_UseEffect_ApplyHediff">
        <hediffDef>EL_Hediff_Adrenaline</hediffDef>
      </li>
      <li Class="EL_CompProperties_EFTStims" />
    </comps>
  </ThingDef>

  <!-- ============================================================ -->
  <!-- Adrenaline x1 单支生产配方 -->
  <!-- ============================================================ -->
  <RecipeDef>
    <defName>EL_Make_Adrenaline</defName>
    <label>制作肾上腺素注射器</label>
    <description>制作1支肾上腺素注射器。</description>
    <jobString>正在制作肾上腺素注射器。</jobString>
    <workAmount>200</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <skillRequirements>
      <Medicine>4</Medicine>
      <Crafting>4</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>DrugProduction</researchPrerequisite>
    <researchPrerequisites>
      <li>PsychiteRefining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Cartridge</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>8</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_Adrenaline>1</EL_Stim_Adrenaline>
    </products>
  </RecipeDef>

  <!-- ============================================================ -->
  <!-- Adrenaline x4 批量生产配方 -->
  <!-- ============================================================ -->
  <RecipeDef>
    <defName>EL_Make_Adrenaline_Bulk</defName>
    <label>制作4个肾上腺素注射器</label>
    <description>制作一批4支肾上腺素注射器。</description>
    <jobString>正在制作肾上腺素注射器。</jobString>
    <workAmount>800</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <skillRequirements>
      <Medicine>4</Medicine>
      <Crafting>4</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>DrugProduction</researchPrerequisite>
    <researchPrerequisites>
      <li>PsychiteRefining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Cartridge</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>32</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_Adrenaline>4</EL_Stim_Adrenaline>
    </products>
  </RecipeDef>

</Defs>
