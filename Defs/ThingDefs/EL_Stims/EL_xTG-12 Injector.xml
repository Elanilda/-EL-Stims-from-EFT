<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- xTG-12 解毒剂注射器 -->
  <!-- 立即清除ToxicBuildup/FoodPoisoning/ScariaInfection/LungRot -->
  <!-- 240秒内持续清除新添加的上述Hediff -->
  <!-- ============================================================ -->
  <ThingDef ParentName="ResourceBase">
    <defName>EL_Stim_xTG12_Antidote</defName>
    <label>xTG-12解毒剂注射器</label>
    <description>广谱抗毒中和剂，能够解除绝大多数人造或自然毒素，其成分分布在血液中时，可提供机体对毒素的免疫效果。对身体自修复功能有副作用。

【施加效果】
立即清除中毒、食物中毒、狂暴症感染与肺瘟，药效期间免疫，延迟0秒/持续240秒；
愈合系数-10%，延迟180秒/持续60秒。</description>
    <descriptionHyperlinks>
      <HediffDef>EL_Hediff_xTG12</HediffDef>
    </descriptionHyperlinks>
    <tickerType>Never</tickerType>
    <orderedTakeGroup>Medicine</orderedTakeGroup>
    <graphicData>
      <texPath>Stims/xTG-12</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.7</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>180</MarketValue>
      <SellPriceFactor>0.8</SellPriceFactor>
      <Mass>0.05</Mass>
      <MaxHitPoints>25</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
      <WorkToMake>320</WorkToMake>
    </statBases>
    <stackLimit>16</stackLimit>
    <uiIconForStackCount>1</uiIconForStackCount>
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>EL_Stims</li>
    </thingCategories>
    <costList>
      <Neutroamine>16</Neutroamine>
    </costList>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>注射 {0}</useLabel>
        <useDuration>120</useDuration>
      </li>
      <li Class="EL_CompProperties_UseEffect_ApplyHediff">
        <hediffDef>EL_Hediff_xTG12</hediffDef>
      </li>
      <li Class="EL_CompProperties_EFTStims" />
    </comps>
  </ThingDef>

  <!-- ============================================================ -->
  <!-- xTG-12 x1 单支生产配方 -->
  <!-- 制作技能: 医疗4 智识8 手工6 -->
  <!-- ============================================================ -->
  <RecipeDef>
    <defName>EL_Make_xTG12</defName>
    <label>制作xTG-12解毒剂注射器</label>
    <description>制作1支xTG-12解毒剂注射器。</description>
    <jobString>正在制作xTG-12解毒剂注射器。</jobString>
    <workAmount>320</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <skillRequirements>
      <Medicine>4</Medicine>
      <Intellectual>8</Intellectual>
      <Crafting>6</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>MedicineProduction</researchPrerequisite>
    <researchPrerequisites>
      <li>PsychiteRefining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EL_Cartridge</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>16</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EL_Cartridge</li>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <EL_Stim_xTG12_Antidote>1</EL_Stim_xTG12_Antidote>
    </products>
  </RecipeDef>

  <!-- ============================================================ -->
