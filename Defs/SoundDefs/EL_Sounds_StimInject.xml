<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- 自定义注射音效 -->
  <!-- 自备音频文件 EL_Stim_Inject.wav 放置在 Sounds/ 目录 -->
  <!-- 格式要求: WAV, 16-bit PCM, 22050Hz 或 44100Hz, 单声道推荐 -->
  <!-- ============================================================ -->
  <SoundDef>
    <defName>EL_Stim_Inject</defName>
    <!-- 播放场景: 仅在地图内播放, 不在全局菜 单/世界地图触发 -->
    <context>MapOnly</context>
    <!-- 同一时刻最多播放1个此音效实例, 防止多次注射叠音 -->
    <maxSimultaneous>1</maxSimultaneous>
    <!-- 子音效列表: 一个SoundDef可含多个subSound按条件混合播放, 这里只用1个 -->
    <subSounds>
      <li>
        <!-- 音频颗粒列表: 决定实际播放哪个音频文件 -->
        <grains>
          <!-- AudioGrain_Clip: 播放单个指定音频文件(对应AudioGrain_Folder随机播放文件夹内所有文件) -->
          <li Class="AudioGrain_Clip">
            <!-- 音频文件路径(不含扩展名), RimWorld自动在Sounds/目录查找EL_Stim_Inject.wav -->
            <clipPath>EL_Stim_Inject</clipPath>
          </li>
        </grains>
        <!-- 音量范围(dB), 格式"最小~最大", 42~42=固定音量不波动, 与原版注射音效一致 -->
        <volumeRange>50~50</volumeRange>
        <!-- 音高随机范围, 1.0=原音高, 0.95~1.05=每次播放随机微调5%, 增加变化避免机械感 -->
        <pitchRange>0.92~1.07</pitchRange>
        <!-- 听觉衰减距离(单位:格), 0格内满音量, 51.86格外听不见, 与原版注射音效一致 -->
        <distRange>0~51.86047</distRange>
        <!-- 是否循环播放, False=单次播放即停(适合短促注射音), True=持续循环(适合环境音) -->
        <sustainLoop>False</sustainLoop>
      </li>
    </subSounds>
  </SoundDef>

</Defs>
